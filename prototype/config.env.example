# 复制本文件为 config.env，把下面三项填上，然后双击「启动.bat」或 npm start
# config.env 已在 .gitignore 里，不会进仓库；不要把 key 发给任何人
#
# endpoint 必须是 OpenAI 兼容接口（能以 /chat/completions 调用）
# 例：智谱 https://open.bigmodel.cn/api/paas/v4
#     DeepSeek https://api.deepseek.com/v1
#     月之暗面 https://api.moonshot.cn/v1
SAFE_OFFICE_LLM_ENDPOINT=
SAFE_OFFICE_LLM_KEY=
SAFE_OFFICE_LLM_MODEL=

# 可选：模型超时（毫秒），默认 60000；带推理的模型一次规划可能要几十秒
# SAFE_OFFICE_LLM_TIMEOUT_MS=60000

# 可选：落盘（不填则内存模式，重启清空）
# SAFE_OFFICE_STORE_FILE=data/ops.db
# SAFE_OFFICE_AUDIT_FILE=data/audit.json

# ---------- 真实 SMTP 发送（可选；不填则用 FakeMailer 模拟） ----------
# QQ 邮箱：smtp.qq.com / 465 / SSL；密码必须填「SMTP 授权码」，不是 QQ 密码。
# 收件人白名单必填；不在白名单的地址一律拒绝（fail-closed）。
# SAFE_OFFICE_SMTP_HOST=smtp.qq.com
# SAFE_OFFICE_SMTP_PORT=465
# SAFE_OFFICE_SMTP_SECURE=1
# SAFE_OFFICE_SMTP_USER=1364387139@qq.com
# SAFE_OFFICE_SMTP_PASS=你的QQ邮箱SMTP授权码
# SAFE_OFFICE_MAIL_FROM=1364387139@qq.com
# SAFE_OFFICE_MAIL_ALLOW_TO=1364387139@qq.com
# SAFE_OFFICE_SMTP_TIMEOUT_MS=20000

# 真实打印（可选）：Windows 打印机名；不填则打印只记录不实际打印
# SAFE_OFFICE_PRINTER=HP LaserJet MFP M232-M237
# 排版打印（v0.40）：配置 PDF 目录后，打印先生成带页眉/密级/水印的 A4 PDF；
# 配了打印机则再把 PDF 提交打印队列；两者都不配 = 模拟
# SAFE_OFFICE_PRINT_PDF_DIR=C:/Users/you/safe-office-print
# Edge 找不到时可显式指定（默认查 Program Files 下的 msedge.exe）
# SAFE_OFFICE_EDGE=C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe
# 日历写入（可选，v0.37）：配置目录后会议预约生成标准 .ics；不填保持模拟
# SAFE_OFFICE_CALENDAR_DIR=C:/Users/you/safe-office-calendar

# ---------- 附件安全（可选） ----------
# 附件落盘加密：32 字节 base64 密钥；丢失后新附件无法解密（旧明文附件仍可读）
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SAFE_OFFICE_BLOB_KEY=
# ClamAV：off（默认）/ auto（有则扫）/ required（没有扫描器就拒绝附件）
# Windows zip 解压版不在 PATH 时，显式指定 exe 与病毒库目录（v0.34）
# SAFE_OFFICE_CLAMAV=auto
# SAFE_OFFICE_CLAMAV_CMD=C:/Users/you/tools/clamav/clamav-1.5.4.win.x64/clamscan.exe
# SAFE_OFFICE_CLAMAV_DB=C:/Users/you/tools/clamav/db

# ---------- MCP 工具接入（可选，v0.36） ----------
# 治理页只允许注册回环地址（127.0.0.1/localhost/::1）的 MCP 服务，防 SSRF
# 确需接远程 MCP 服务时显式打开（风险自负：服务端会收到你的工具调用参数）
# SAFE_OFFICE_MCP_ALLOW_REMOTE=1
# 已注册 MCP 服务落盘位置（含 token，文件权限 0600；默认 data/mcp-servers.json）
# SAFE_OFFICE_MCP_FILE=data/mcp-servers.json

# ---------- 退信邮箱轮询（可选，v0.39） ----------
# 开启后定时拉取未读邮件，只处理 DSN 退信（普通邮件不标已读）；
# QQ 邮箱需先在网页版设置里开启 IMAP 服务，密码填授权码。
# SAFE_OFFICE_IMAP_HOST=imap.qq.com
# SAFE_OFFICE_IMAP_PORT=993
# SAFE_OFFICE_IMAP_SECURE=1
# SAFE_OFFICE_IMAP_USER=you@qq.com
# SAFE_OFFICE_IMAP_PASS=
# SAFE_OFFICE_IMAP_MAILBOX=INBOX
# SAFE_OFFICE_IMAP_POLL_MS=60000
# SAFE_OFFICE_IMAP_MAX=20

# ---------- 登录（可选） ----------
# 用户表默认 data/users.json；存在即启用登录。添加用户：
#   SAFE_OFFICE_NEW_USER_PASSWORD=... node add-user.cjs alice 员工
# SAFE_OFFICE_USERS_FILE=data/users.json
# 会话落盘（v0.32）：只存 token 的 SHA-256；默认 data/sessions.json
# SAFE_OFFICE_SESSIONS_FILE=data/sessions.json
# SAFE_OFFICE_AUTH=required

# ---------- 审计检查点（可选） ----------
# 32B base64；配置后检查点带 HMAC，篡改/换链都会被拒
# SAFE_OFFICE_AUDIT_KEY=
# 检查点独立路径（可放另一块盘）
# SAFE_OFFICE_AUDIT_CHECKPOINT=D:/secure/audit.head
