# 复制本文件为 config.env，把下面三项填上，然后双击「启动.bat」或 npm start
# config.env 已在 .gitignore 里，不会进仓库；不要把 key 发给任何人
#
# endpoint 必须是 OpenAI 兼容接口（能以 /chat/completions 调用）
# 例：智谱 https://open.bigmodel.cn/api/paas/v4
#     DeepSeek https://api.deepseek.com/v1
#     月之暗面 https://api.moonshot.cn/v1
SAFE_OFFICE_LLM_ENDPOINT=
SAFE_OFFICE_LLM_KEY=
SAFE_OFFICE_LLM_MODEL=

# 可选：模型超时（毫秒），默认 60000；带推理的模型一次规划可能要几十秒
# SAFE_OFFICE_LLM_TIMEOUT_MS=60000

# 可选：落盘（不填则内存模式，重启清空）
# SAFE_OFFICE_STORE_FILE=data/ops.db
# SAFE_OFFICE_AUDIT_FILE=data/audit.json
