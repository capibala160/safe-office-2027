{
  "name": "safe-office-prototype",
  "version": "0.52.2",
  "private": true,
  "description": "安全智慧办公 · Agent 安全运行机制核心原型 + 办公套件控制台（平台无关；上板时平移 ArkTS）",
  "scripts": {
    "start": "node server.cjs",
    "start:lan": "node server.cjs --lan",
    "serve": "node server.cjs",
    "demo": "node demo.cjs",
    "demo:nearfield": "node demo-nearfield.cjs",
    "demo:start": "node scripts/demo-start.cjs",
    "demo:reset": "node scripts/demo-start.cjs --reset",
    "demo:check": "node scripts/demo-start.cjs --check",
    "demo:preflight": "node scripts/demo-preflight.cjs",
    "backup": "node scripts/backup.cjs",
    "restore": "node scripts/restore-backup.cjs",
    "test": "node --test",
    "lint": "eslint . && node scripts/lint.cjs",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:strict": "tsc -p tsconfig.strict.json",
    "health": "node scripts/healthcheck.cjs",
    "ci": "npm run lint && npm run typecheck && npm run typecheck:strict && npm test && node --test e2e/ui.e2e.cjs",
    "eval": "node eval/run.cjs",
    "eval:ablate": "node eval/run.cjs --ablate=all",
    "import": "node import-doc.cjs",
    "e2e": "node --test e2e/ui.e2e.cjs",
    "share:check": "node e2e/share-check.cjs",
    "asr:probe": "node scripts/asr-probe.cjs",
    "actuator:probe": "node scripts/actuator-probe.cjs",
    "bench": "node bench/load.cjs",
    "audit:keygen": "node scripts/audit-keygen.cjs",
    "verify:audit": "node verify-audit.cjs",
    "lint:custom": "node scripts/lint.cjs",
    "bench:audit": "node bench/audit-checkpoints.cjs",
    "serial:confirm": "node serial-confirm.cjs",
    "serial:probe": "node scripts/serial-probe.cjs",
    "sfc1:neg": "node scripts/sfc1-negative.cjs",
    "console:serial": "node scripts/console-serial-check.cjs",
    "ws63:build": "node ../ws63/firmware/build-m3.cjs --build",
    "provision": "node scripts/provision-device.cjs"
  },
  "dependencies": {
    "imapflow": "^2.10.0",
    "nodemailer": "^6.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.4",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^15.15.0",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "serialport": "^13.0.0"
  }
}
