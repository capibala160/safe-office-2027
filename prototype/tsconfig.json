{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "types": ["node"]
  },
  "include": [
    "src/**/*.cjs",
    "eval/**/*.cjs",
    "scripts/**/*.cjs",
    "server.cjs",
    "demo.cjs",
    "demo-nearfield.cjs",
    "import-doc.cjs"
  ]
}
